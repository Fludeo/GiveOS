{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"paths": {
			"#lib": ["./src/lib"],
			"#lib/*": ["./src/lib/*"],
			"$lib": ["./src/lib"],
			"$lib/*": ["./src/lib/*"]
		},
		"types": [
			"$app/types",
			"node"
		]
	},
	"include": [
		"src",
		"vite.config.ts",
		"drizzle.config.ts"
	],
	"exclude": [
		"src/service-worker",
		"src/service-worker.ts",
		"src/service-worker/**"
	]
}
